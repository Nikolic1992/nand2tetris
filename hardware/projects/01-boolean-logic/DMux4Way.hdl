/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 *
 * Truth table (selection):
 * sel[1:0] | active output
 *     0 0  |       a
 *     0 1  |       b
 *     1 0  |       c
 *     1 1  |       d
 *
 */

CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:

    // sel[1] routes in to the a/b group (0) or c/d group (1).
    DMux(in=in, sel=sel[1], a=firstGroup, b=secondGroup);
    
    // sel[0] selects one output within each group.
    DMux(in=firstGroup, sel=sel[0], a=a, b=b);
    DMux(in=secondGroup, sel=sel[0], a=c, b=d);
}