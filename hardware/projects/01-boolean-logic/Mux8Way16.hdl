/**
 * 8-way 16-bit multiplexor:
 * out = a if sel = 000
 *       b if sel = 001
 *       c if sel = 010
 *       d if sel = 011
 *       e if sel = 100
 *       f if sel = 101
 *       g if sel = 110
 *       h if sel = 111
 *
 * Truth table (selection):
 * sel[2:1:0] | out
 *     0 0 0  |  a
 *     0 0 1  |  b
 *     0 1 0  |  c
 *     0 1 1  |  d
 *     1 0 0  |  e
 *     1 0 1  |  f
 *     1 1 0  |  g
 *     1 1 1  |  h
 *
 */

CHIP Mux8Way16 {
    IN a[16], b[16], c[16], d[16],
       e[16], f[16], g[16], h[16],
       sel[3];
    OUT out[16];

    PARTS:

    // sel[0] selects one bus from each adjacent pair, bit by bit.
    Mux16(a=a, b=b, sel=sel[0], out=out1);
    Mux16(a=c, b=d, sel=sel[0], out=out2);
    Mux16(a=e, b=f, sel=sel[0], out=out3);
    Mux16(a=g, b=h, sel=sel[0], out=out4);

    // sel[1] selects between the pair results within each group of four.
    Mux16(a=out1, b=out2, sel=sel[1], out=out5);
    Mux16(a=out3, b=out4, sel=sel[1], out=out6);

    // sel[2] selects the first or second group of four.
    Mux16(a=out5, b=out6, sel=sel[2], out=out);
}