/**
 * 4-way 16-bit multiplexor:
 * out = a if sel = 00
 *       b if sel = 01
 *       c if sel = 10
 *       d if sel = 11
 *
 * Truth table (selection):
 * sel[1:0] | out
 *     0 0  |  a
 *     0 1  |  b
 *     1 0  |  c
 *     1 1  |  d
 */

CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];

    PARTS:

    // sel[0] chooses a or b for every bit.
    Mux16(a=a, b=b, sel=sel[0], out=out1);

    // sel[0] chooses c or d for every bit.
    Mux16(a=c, b=d, sel=sel[0], out=out2);

    // sel[1] chooses which pair's selected 16-bit bus is output.
    Mux16(a=out1, b=out2, sel=sel[1], out=out);
}