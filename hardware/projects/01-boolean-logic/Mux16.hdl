/**
 * 16-bit multiplexor: 
 * for i = 0, ..., 15:
 * if (sel = 0) out[i] = a[i], else out[i] = b[i]
 *
 * Truth table for each bit:
 * sel | out[i]
 *  0  | a[i]
 *  1  | b[i]
 *
 */
 
CHIP Mux16 {
    IN a[16], b[16], sel;
    OUT out[16];

    PARTS:

    // Each Mux selects the same bit position from a or b.
    Mux(a=a[0], b=b[0], sel=sel, out=out[0]);   // Bit 0
    Mux(a=a[1], b=b[1], sel=sel, out=out[1]);   // Bit 1
    Mux(a=a[2], b=b[2], sel=sel, out=out[2]);   // Bit 2
    Mux(a=a[3], b=b[3], sel=sel, out=out[3]);   // Bit 3
    Mux(a=a[4], b=b[4], sel=sel, out=out[4]);   // Bit 4
    Mux(a=a[5], b=b[5], sel=sel, out=out[5]);   // Bit 5
    Mux(a=a[6], b=b[6], sel=sel, out=out[6]);   // Bit 6
    Mux(a=a[7], b=b[7], sel=sel, out=out[7]);   // Bit 7
    Mux(a=a[8], b=b[8], sel=sel, out=out[8]);   // Bit 8
    Mux(a=a[9], b=b[9], sel=sel, out=out[9]);   // Bit 9
    Mux(a=a[10], b=b[10], sel=sel, out=out[10]); // Bit 10
    Mux(a=a[11], b=b[11], sel=sel, out=out[11]); // Bit 11
    Mux(a=a[12], b=b[12], sel=sel, out=out[12]); // Bit 12
    Mux(a=a[13], b=b[13], sel=sel, out=out[13]); // Bit 13
    Mux(a=a[14], b=b[14], sel=sel, out=out[14]); // Bit 14
    Mux(a=a[15], b=b[15], sel=sel, out=out[15]); // Bit 15
}