/**
* 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 *
 * Truth table (selection):
 * sel[2:1:0] | active output
 *     0 0 0  |       a
 *     0 0 1  |       b
 *     0 1 0  |       c
 *     0 1 1  |       d
 *     1 0 0  |       e
 *     1 0 1  |       f
 *     1 1 0  |       g
 *     1 1 1  |       h
 *
 */
 
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:

    // sel[2] selects the first four outputs or the last four.
    DMux(in=in, sel=sel[2], a=firstGroup, b=secondGroup);

    // sel[1] selects one pair within each group.
    DMux(in=firstGroup, sel=sel[1], a=leftGroup, b=rightGroup);
    DMux(in=secondGroup, sel=sel[1], a=thirdGroup, b=fourthGroup);

    // sel[0] selects the output within each pair.
    DMux(in=leftGroup, sel=sel[0], a=a, b=b);
    DMux(in=rightGroup, sel=sel[0], a=c, b=d);
    DMux(in=thirdGroup, sel=sel[0], a=e, b=f);
    DMux(in=fourthGroup, sel=sel[0], a=g, b=h);
}