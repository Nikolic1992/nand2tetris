/**
 * ALU (Arithmetic Logic Unit):
 *
 * Computes one of the following functions:
 * 0, 1, -1,
 * x, y, !x, !y, -x, -y,
 * x + 1, y + 1, x - 1, y - 1,
 * x + y, x - y, y - x,
 * x & y, x | y
 *
 * The function is selected using the control bits:
 * zx, nx, zy, ny, f, no.
 *
 * Outputs:
 * out - 16-bit result
 * zr  - 1 if out == 0, otherwise 0
 * ng  - 1 if out < 0, otherwise 0
 *
 * Implementation:
 * 1. Optionally zero or negate the x input.
 * 2. Optionally zero or negate the y input.
 * 3. Compute either x AND y or x + y.
 * 4. Optionally negate the result.
 * 5. Compute the zero and negative flags.
 *
 */

CHIP ALU {
    IN
        x[16], y[16],  // 16-bit inputs
        zx,            // Zero the x input?
        nx,            // Negate the x input?
        zy,            // Zero the y input?
        ny,            // Negate the y input?
        f,             // Compute x + y or x AND y?
        no;            // Negate the output?

    OUT
        out[16],       // 16-bit output
        zr,            // 1 if the output is zero
        ng;            // 1 if the output is negative

    PARTS:

    // --------------------------------------------------
    // 1. PREPROCESS THE X INPUT
    // --------------------------------------------------

    // Invert all 16 bits of x.
    // This provides the !x value when nx is enabled.
    Not16(in=x, out=notx);

    // Select one of four possible values for x:
    // sel = 00 -> original x
    // sel = 01 -> !x
    // sel = 10 -> 0
    // sel = 11 -> 1 (all 16 bits set to 1)
    //
    // zx controls the most significant selection bit.
    // nx controls the least significant selection bit.
    Mux4Way16(
        a=x,
        b=notx,
        c[0..15]=false,
        d[0..15]=true,
        sel[1]=zx,
        sel[0]=nx,
        out=a
    );


    // --------------------------------------------------
    // 2. PREPROCESS THE Y INPUT
    // --------------------------------------------------

    // Invert all 16 bits of y.
    // This provides the !y value when ny is enabled.
    Not16(in=y, out=noty);

    // Select one of four possible values for y:
    // sel = 00 -> original y
    // sel = 01 -> !y
    // sel = 10 -> 0
    // sel = 11 -> 1 (all 16 bits set to 1)
    //
    // zy controls the most significant selection bit.
    // ny controls the least significant selection bit.
    Mux4Way16(
        a=y,
        b=noty,
        c[0..15]=false,
        d[0..15]=true,
        sel[1]=zy,
        sel[0]=ny,
        out=b
    );


    // --------------------------------------------------
    // 3. COMPUTE THE LOGICAL AND ARITHMETIC RESULTS
    // --------------------------------------------------

    // Compute the bitwise AND of the processed x and y.
    // This result is selected when f = 0.
    And16(a=a, b=b, out=aANDb);

    // Add the processed x and y values.
    // This result is selected when f = 1.
    Add16(a=a, b=b, out=aADDb);

    // Select the operation result:
    // f = 0 -> a AND b
    // f = 1 -> a + b
    Mux16(a=aANDb, b=aADDb, sel=f, out=o);


    // --------------------------------------------------
    // 4. OPTIONALLY NEGATE THE OUTPUT
    // --------------------------------------------------

    // Invert all 16 bits of the selected result.
    Not16(in=o, out=noto);

    // Select the final output:
    // no = 0 -> original result
    // no = 1 -> bitwise NOT of the result
    //
    // Also expose the most significant output bit as ng.
    // Split the output into two 8-bit buses for zero detection.
    Mux16(
        a=o,
        b=noto,
        sel=no,
        out=out,
        out[15]=ng,
        out[0..7]=out8LSB,
        out[8..15]=out8MSB
    );


    // --------------------------------------------------
    // 5. COMPUTE THE ZERO FLAG (zr)
    // --------------------------------------------------

    // Check whether any bit in the lower 8 bits is 1.
    Or8Way(in=out8LSB, out=or8LSB);

    // Check whether any bit in the upper 8 bits is 1.
    Or8Way(in=out8MSB, out=or8MSB);

    // If either group contains a 1, the complete output
    // is not zero.
    Or(a=or8LSB, b=or8MSB, out=or16out);

    // Invert the result:
    // zr = 1 when all 16 output bits are zero.
    Not(in=or16out, out=zr);
}